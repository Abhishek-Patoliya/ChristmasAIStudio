# Backend Server Configuration
PORT=8080
NODE_ENV=development

# OpenAI API Key (Never embed in iOS client!)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Target Model for Image Generation & Editing
# e.g., dall-e-3 or dall-e-2
OPENAI_IMAGE_MODEL=dall-e-3

# Base URL where this server is accessible to clients
SERVER_BASE_URL=http://localhost:8080
